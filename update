#!/bin/bash

# ===============================================
# ZuzPanel Auto-Updater & ZPM Manager
# Checks GitHub for updates and rebuilds apps
# Run as root or user with sudo privileges
# ===============================================

set -euo pipefail

# Configuration
REPO_URL="https://github.com/zuzpk/zpanel.git"
ZPANEL_ROOT="/zpanel"
REST_DIR="$ZPANEL_ROOT/rest"
UI_DIR="$ZPANEL_ROOT/ui"
SERVICE_NAME="zpanel-zpm"

echo "=== ZuzPanel Auto-Updater ==="
cd "$ZPANEL_ROOT"

# 1. Fetch latest state
git fetch origin main

# 2. Check for changes
LOCAL=$(git rev-parse HEAD)
REMOTE=$(git rev-parse origin/main)

# Update ZPM
echo "→ Ensuring @zuzjs/pm is latest..."
sudo npm i -g @zuzjs/pm@latest

# --- NEW: ZPM SERVICE GENERATION ---
echo "→ Configuring $SERVICE_NAME..."

# Find the global node_modules path dynamically
NPM_GLOBAL_ROOT=$(npm root -g)
ZPM_DAEMON_PATH="$NPM_GLOBAL_ROOT/@zuzjs/pm/dist/daemon.cjs"
NODE_BIN=$(which node)

if [ ! -f "$ZPM_DAEMON_PATH" ]; then
    echo "✗ Error: daemon.cjs not found at $ZPM_DAEMON_PATH"
    # Fallback check for .js extension
    ZPM_DAEMON_PATH="$NPM_GLOBAL_ROOT/@zuzjs/pm/dist/daemon.js"
fi

# Generate the systemd unit file
cat <<EOF | sudo tee /etc/systemd/system/$SERVICE_NAME.service > /dev/null
[Unit]
Description=ZuzJS Process Manager Daemon
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=$ZPANEL_ROOT
ExecStart=$NODE_BIN $ZPM_DAEMON_PATH
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=ZPM_NAMESPACE=zuzjs-pm
# Ensure global bins are in path
Environment=PATH=$(dirname $NODE_BIN):/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
EOF

echo "→ Restarting $SERVICE_NAME..."
sudo systemctl daemon-reload
sudo systemctl enable $SERVICE_NAME
sudo systemctl restart $SERVICE_NAME
# -----------------------------------

if [ "$LOCAL" = "$REMOTE" ]; then

    sudo npm i -g @zuzjs/pm@latest

    echo "✓ ZuzPanel is already up to date."
    exit 0
fi

echo "→ Update found! Saving local changes..."

# 3. SAFE SYNC: Stash -> Reset -> Pop
# This ensures git stash doesn't see them as problematic local changes
rm -f "$REST_DIR/tsconfig.tsbuildinfo"
rm -f "$REST_DIR/zpanel.pid"

echo "→ Resetting CSS maps to match remote..."
git checkout HEAD -- ui/src/app/css/zuz.scss
git checkout HEAD -- ui/src/app/css/zuzmap.ts

# Check if there are local changes to stash
if ! git diff-index --quiet HEAD --; then
    echo ": Stashing local changes..."
    git stash
    HAS_STASH=true
else
    HAS_STASH=false
fi

echo "→ Synchronizing code with origin/main..."
# We use reset --hard because GitHub history is squashed/rewritten
git reset --hard origin/main

if [ "$HAS_STASH" = true ]; then
    echo ":: Re-applying local changes..."
    # 'stash pop' might conflict if you changed the same lines GitHub changed
    if git stash pop; then
        echo "✓ Local changes merged."
    else
        echo "::: Conflicts detected! Manual resolution required in $ZPANEL_ROOT."
        # We don't exit 1 here so the build still tries to run
    fi
fi

# 5. Build REST
if [ -d "$REST_DIR" ]; then
    echo "→ Rebuilding REST..."
    (
        cd "$REST_DIR"
        pnpm install --silent
        if pnpm build; then
            echo "✓ REST built successfully."
            # Restart service to apply changes
            sudo systemctl restart zpanel-rest || true
        else
            echo "✗ REST build failed."
            exit 1
        fi
    )
fi

# 6. Build UI
if [ -d "$UI_DIR" ]; then
    echo "→ Rebuilding UI..."
    (
        cd "$UI_DIR"
        pnpm install --silent
        if pnpm build; then
            echo "✓ UI built successfully."
            sudo systemctl restart zpanel-ui || true
        else
            echo "✗ UI build failed."
            exit 1
        fi
    )
fi

echo "=== Update Successful ==="