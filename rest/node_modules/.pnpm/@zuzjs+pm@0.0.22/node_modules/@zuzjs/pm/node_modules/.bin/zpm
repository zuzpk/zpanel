#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/zpanel/rest/node_modules/.pnpm/@zuzjs+pm@0.0.22/node_modules/@zuzjs/pm/dist/node_modules:/zpanel/rest/node_modules/.pnpm/@zuzjs+pm@0.0.22/node_modules/@zuzjs/pm/node_modules:/zpanel/rest/node_modules/.pnpm/@zuzjs+pm@0.0.22/node_modules/@zuzjs/node_modules:/zpanel/rest/node_modules/.pnpm/@zuzjs+pm@0.0.22/node_modules:/zpanel/rest/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/zpanel/rest/node_modules/.pnpm/@zuzjs+pm@0.0.22/node_modules/@zuzjs/pm/dist/node_modules:/zpanel/rest/node_modules/.pnpm/@zuzjs+pm@0.0.22/node_modules/@zuzjs/pm/node_modules:/zpanel/rest/node_modules/.pnpm/@zuzjs+pm@0.0.22/node_modules/@zuzjs/node_modules:/zpanel/rest/node_modules/.pnpm/@zuzjs+pm@0.0.22/node_modules:/zpanel/rest/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../dist/cli.cjs" "$@"
else
  exec node  "$basedir/../../dist/cli.cjs" "$@"
fi
